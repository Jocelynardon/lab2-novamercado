# Copiar a .env antes de levantar:  cp .env.example .env
# (Para la evaluación local se pueden dejar estos valores; en un ambiente real, cámbielos.)

# --- Base de datos del producto
PRODUCT_DB_USER=novamercado
PRODUCT_DB_PASSWORD=cambiar_clave_producto
PRODUCT_DB_NAME=novamercado

# --- Base de datos de metadatos de Airflow (separada de la del producto)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiar_clave_airflow

# --- Usuario de Airflow (UI en http://localhost:8080 y API REST)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_clave_admin
AIRFLOW_JWT_SECRET=cambiar_por_un_texto_largo_y_aleatorio

# --- Modelo
MODEL_NAME=novamercado_ventas
MODEL_ALIAS=champion
# El candidato reemplaza al vigente si su costo en validación es al menos 1% menor
MEJORA_MINIMA=0.01
